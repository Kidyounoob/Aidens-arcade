    <main id="main">
      <section class="section container">
        <div class="head">
          <h2>Blackjack</h2>
          <p>Beat the dealer to 21 without going bust. Blackjack pays 3:2.</p>
        </div>

        <div class="bjWrap">

          <!-- HUD -->
          <div class="card bjHud">
            <div class="bjStats">
              <div class="statTile">
                <div class="statLabel">Chips</div>
                <div class="statValue" id="chipsEl">1000</div>
              </div>
              <div class="statTile">
                <div class="statLabel">Wins</div>
                <div class="statValue" id="winsEl">0</div>
              </div>
              <div class="statTile">
                <div class="statLabel">Losses</div>
                <div class="statValue" id="lossesEl">0</div>
              </div>
              <div class="statTile">
                <div class="statLabel">Streak</div>
                <div class="statValue" id="streakEl">0</div>
              </div>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <button class="btn" id="resetBtn" type="button">Reset</button>
              <a class="btn" href="../">Back</a>
            </div>
          </div>

          <!-- Result banner -->
          <div class="resultBanner" id="resultBanner" hidden></div>

          <!-- Table -->
          <div class="card bjTable">
            <!-- Dealer -->
            <div class="handZone">
              <div class="handLabel">
                Dealer
                <span class="handValue" id="dealerVal">—</span>
              </div>
              <div class="cardsRow" id="dealerCards"></div>
            </div>

            <div class="felt-line"></div>

            <!-- Player -->
            <div class="handZone">
              <div class="handLabel">
                You
                <span class="handValue" id="playerVal">—</span>
              </div>
              <div class="cardsRow" id="playerCards"></div>
            </div>
          </div>

          <!-- Bet strip -->
          <div class="card bjBetStrip">
            <div class="chipRow" id="chipRow">
              <button class="chip c1"   data-val="1"   aria-label="1 chip">1</button>
              <button class="chip c5"   data-val="5"   aria-label="5 chips">5</button>
              <button class="chip c10"  data-val="10"  aria-label="10 chips">10</button>
              <button class="chip c25"  data-val="25"  aria-label="25 chips">25</button>
              <button class="chip c100" data-val="100" aria-label="100 chips">100</button>
            </div>
            <div class="bjBetInfo">
              <div>
                <div class="statLabel" style="margin-bottom:4px;">Bet</div>
                <div class="betDisplay" id="betEl">0</div>
              </div>
              <button class="btn" id="clearBetBtn" type="button">Clear</button>
              <button class="btn primary" id="dealBtn" type="button">Deal</button>
            </div>
          </div>

          <!-- Actions -->
          <div class="card bjActions" id="actionsCard" style="display:none;">
            <button class="btn primary" id="hitBtn"     type="button">Hit</button>
            <button class="btn"         id="standBtn"   type="button">Stand</button>
            <button class="btn"         id="doubleBtn"  type="button">Double</button>
            <button class="btn"         id="nextBtn"    type="button" style="display:none;">Next Hand</button>
          </div>

          <div class="hint">Click chips to bet • Deal to start • Double doubles your bet and gives one card</div>
        </div>
      </section>
