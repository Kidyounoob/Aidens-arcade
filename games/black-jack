<!doctype html>
<html lang="en" data-mode="dark" data-theme="darkwater">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>Blackjack • Aiden's Arcade</title>

    <link rel="stylesheet" href="../../styles.css?v=2" />
    <script defer src="../../app.js?v=2"></script>

    <style>
      .bjWrap { display: grid; gap: 12px; }

      /* ── HUD ── */
      .bjHud {
        padding: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
      }
      .bjStats { display: flex; gap: 10px; flex-wrap: wrap; }
      .statTile {
        border: 1px solid var(--border);
        background: var(--panel);
        border-radius: 16px;
        padding: 10px 16px;
        min-width: 80px;
        text-align: center;
      }
      .statLabel {
        color: var(--muted);
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .statValue {
        font-weight: 980;
        font-size: 20px;
        margin-top: 2px;
        letter-spacing: -0.02em;
      }

      /* ── Table ── */
      .bjTable {
        padding: 20px 16px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        background: radial-gradient(ellipse at 50% 60%, rgba(5,90,50,.55), rgba(0,0,0,.0));
        position: relative;
        min-height: 380px;
      }

      .handZone { display: flex; flex-direction: column; gap: 8px; }
      .handLabel {
        font-weight: 900;
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .handValue {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--panel2);
        font-size: 13px;
        font-weight: 980;
        color: var(--text);
      }
      .handValue.bust   { background: rgba(239,68,68,.25);  border-color: rgba(239,68,68,.4); color: #fca5a5; }
      .handValue.bj     { background: rgba(245,158,11,.25); border-color: rgba(245,158,11,.4); color: #fde68a; }
      .handValue.win    { background: rgba(34,197,94,.25);  border-color: rgba(34,197,94,.4);  color: #86efac; }

      /* ── Cards ── */
      .cardsRow {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: flex-start;
        min-height: 110px;
      }

      .card-el {
        width: 72px;
        height: 104px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.18);
        background: #fff;
        color: #111;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        padding: 6px 7px;
        font-weight: 900;
        font-size: 17px;
        box-shadow: 0 6px 22px rgba(0,0,0,.45);
        position: relative;
        animation: cardDeal .22s cubic-bezier(.22,1,.36,1) both;
        user-select: none;
        flex-shrink: 0;
      }
      @keyframes cardDeal {
        from { transform: translateY(-24px) scale(0.88); opacity: 0; }
        to   { transform: translateY(0) scale(1); opacity: 1; }
      }

      .card-el.red  { color: #dc2626; }
      .card-el.back {
        background: linear-gradient(135deg, #1e3a5f, #0f2745);
        color: transparent;
        border-color: rgba(255,255,255,.15);
      }
      .card-el.back::after {
        content: "🌊";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 28px;
        opacity: .55;
      }

      .card-rank { line-height: 1; }
      .card-suit { font-size: 13px; line-height: 1; }
      .card-center {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 28px;
        line-height: 1;
        pointer-events: none;
      }
      .card-el .card-rank.bot {
        align-self: flex-end;
        transform: rotate(180deg);
      }

      /* ── Bet strip ── */
      .bjBetStrip {
        padding: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }
      .chipRow { display: flex; gap: 8px; flex-wrap: wrap; }
      .chip {
        width: 52px;
        height: 52px;
        border-radius: 999px;
        border: 3px dashed rgba(255,255,255,.25);
        font-weight: 980;
        font-size: 13px;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: transform 120ms, filter 120ms;
        user-select: none;
      }
      .chip:hover  { transform: translateY(-3px) scale(1.06); filter: brightness(1.15); }
      .chip:active { transform: scale(.94); }
      .chip.c1    { background: radial-gradient(circle at 35% 35%, #6b7280, #374151); color: #e5e7eb; }
      .chip.c5    { background: radial-gradient(circle at 35% 35%, #ef4444, #991b1b); color: #fff; }
      .chip.c10   { background: radial-gradient(circle at 35% 35%, #3b82f6, #1d4ed8); color: #fff; }
      .chip.c25   { background: radial-gradient(circle at 35% 35%, #22c55e, #15803d); color: #fff; }
      .chip.c100  { background: radial-gradient(circle at 35% 35%, #f59e0b, #b45309); color: #fff; }

      .bjBetInfo {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .betDisplay {
        border: 1px solid var(--border);
        background: var(--panel);
        border-radius: 14px;
        padding: 10px 14px;
        font-weight: 980;
        font-size: 16px;
        min-width: 80px;
        text-align: center;
      }

      /* ── Action buttons ── */
      .bjActions {
        padding: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }
      .bjActions .btn { min-width: 90px; }

      /* ── Result banner ── */
      .resultBanner {
        text-align: center;
        padding: 16px;
        border-radius: 16px;
        font-weight: 980;
        font-size: 20px;
        letter-spacing: -0.02em;
        animation: bannerPop .3s cubic-bezier(.22,1,.36,1) both;
      }
      @keyframes bannerPop {
        from { transform: scale(.8); opacity: 0; }
        to   { transform: scale(1);  opacity: 1; }
      }
      .resultBanner.win  { background: rgba(34,197,94,.22);  border: 1px solid rgba(34,197,94,.4);  color: #86efac; }
      .resultBanner.lose { background: rgba(239,68,68,.22);  border: 1px solid rgba(239,68,68,.4);  color: #fca5a5; }
      .resultBanner.push { background: rgba(148,163,184,.18); border: 1px solid rgba(148,163,184,.3); color: #cbd5e1; }
      .resultBanner.bj   { background: rgba(245,158,11,.22); border: 1px solid rgba(245,158,11,.4); color: #fde68a; }
      .resultBanner[hidden] { display: none !important; }

      /* divider */
      .felt-line {
        height: 1px;
        background: rgba(255,255,255,.08);
        margin: 0;
      }

      .hint {
        color: var(--muted);
        font-size: 13px;
        font-weight: 820;
        text-align: center;
        padding: 4px 0 8px;
      }
    </style>
  </head>

